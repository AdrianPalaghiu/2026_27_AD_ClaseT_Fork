# IntelliJ IDEA: configuración local (en cualquier proyecto del repositorio)
.idea/
*.iml
*.ipr
*.iws

# Java: archivos compilados y salida del IDE
*.class
out/
hs_err_pid*
replay_pid*

# Maven
target/

# Gradle
.gradle/
build/

# Registros de ejecución
*.log

# Configuración privada local: compartir plantillas sin credenciales reales
.env
.env.*
!.env.example
!.env.template
db-local.properties
application-local.properties

# Archivos del sistema operativo
.DS_Store
._*
Thumbs.db
Desktop.ini

# Se conservan fuentes, pom.xml, scripts SQL y datos de ejemplo.
# También se conservan los wrappers de Maven y Gradle y sus archivos JAR.
# No ignorar globalmente *.jar, *.xml, *.sql, *.csv ni *.properties.